# Copia este archivo a .env.local y rellena con los valores de tu proyecto Supabase
# (Project Settings > API en el dashboard de Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo para scripts server-side/administrativos (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# VAPID keys para Web Push (siguiente iteración)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
